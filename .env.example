# =============================================================================
# Larimar — environment template
#
# Copy to `.env` and fill in. NEVER commit `.env`.
# Generate every secret below with:  openssl rand -base64 32
# In production these must come from a managed secret store (AWS Secrets Manager,
# GCP Secret Manager, Vault) with automatic rotation — not from a file on disk.
# =============================================================================

# --- Core -------------------------------------------------------------------
NODE_ENV=development
APP_URL=http://localhost:3000
APP_NAME=Larimar

# DEMO_MODE=true enables mock providers and the seeded demo accounts.
# The application REFUSES TO BOOT with DEMO_MODE=false unless every provider
# below is set to a real implementation — this is a deliberate safety interlock.
DEMO_MODE=true

# Insecure shortcuts, each behind its own flag so either can be switched off
# without abandoning demo mode. Both MUST be false in production; the process
# prints a loud warning at startup listing whichever are active.
DEMO_ALLOW_MFA_BYPASS=true
DEMO_LOG_RESET_TOKENS=true

# --- Database ---------------------------------------------------------------
DATABASE_URL=postgresql://larimar:larimar_dev_password@localhost:5433/larimar?schema=public

# --- Cryptographic secrets (32+ bytes each, base64) -------------------------
# Signs and verifies session material.
SESSION_SECRET=replace-me-with-openssl-rand-base64-32
# AES-256-GCM key for encrypting TOTP secrets and partner API secrets at rest.
# Must decode to exactly 32 bytes.
ENCRYPTION_KEY=replace-me-with-openssl-rand-base64-32
# Mixed into pickup-code hashing so a database dump alone cannot redeem cash.
# ROTATING THIS INVALIDATES EVERY OUTSTANDING PICKUP CODE.
PICKUP_CODE_PEPPER=replace-me-with-openssl-rand-base64-32

# --- Session policy ---------------------------------------------------------
SESSION_ABSOLUTE_TTL_HOURS=12
SESSION_IDLE_TTL_MINUTES=30
SESSION_COOKIE_NAME=larimar_session

# --- Provider selection -----------------------------------------------------
# mock | (a real provider key, once one is legally and contractually available)
PAYMENT_PROVIDER=mock
EXCHANGE_RATE_PROVIDER=mock
KYC_PROVIDER=mock
SANCTIONS_PROVIDER=mock
NOTIFICATION_TRANSPORT=mock

# --- Webhook verification ---------------------------------------------------
PAYMENT_WEBHOOK_SECRET=replace-me-with-openssl-rand-base64-32
KYC_WEBHOOK_SECRET=replace-me-with-openssl-rand-base64-32
# Reject webhooks whose timestamp is older than this (replay defence).
WEBHOOK_TOLERANCE_SECONDS=300

# --- Partner API ------------------------------------------------------------
PARTNER_API_ENABLED=true
PARTNER_SIGNATURE_TOLERANCE_SECONDS=300

# --- Rate limiting ----------------------------------------------------------
RATE_LIMIT_LOGIN_PER_15MIN=10
# Registrations per hour per IP. The E2E suite creates several accounts from one
# address, so playwright.config.ts raises this for the server it manages.
RATE_LIMIT_REGISTER_PER_HOUR=5
RATE_LIMIT_QUOTE_PER_MIN=60
RATE_LIMIT_PICKUP_VERIFY_PER_MIN=10
RATE_LIMIT_DEFAULT_PER_MIN=120

# --- Business defaults (overridden by database rows once seeded) ------------
DEFAULT_COUNTRY=DO
QUOTE_TTL_SECONDS=900
# Re-price if the live rate drifts more than this from the quoted rate.
RATE_DRIFT_TOLERANCE_BPS=50
PICKUP_CODE_TTL_DAYS=30
PICKUP_CODE_MAX_ATTEMPTS=5

# --- Android / Google Play (Trusted Web Activity) ------------------------------
# Both are required for Digital Asset Links verification, which is what removes
# the browser URL bar from the installed app. The fingerprint MUST be the Play
# App Signing certificate, not your local upload key.
# Leave unset until the Android app exists; /.well-known/assetlinks.json 404s.
ANDROID_PACKAGE_NAME=
ANDROID_SHA256_FINGERPRINT=

# --- Demo seed accounts (DEMO_MODE only; ignored otherwise) -----------------
DEMO_PASSWORD=DemoPass123!
